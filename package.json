{
  "name": "vibesui-hackathon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "pnpm --filter @vibesui/web dev",
    "dev:local-agent": "pnpm --filter @vibesui/local-agent dev",
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "test:e2e": "corepack pnpm --filter @vibesui/web test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "move:build": "cd packages/move && sui move build",
    "move:test": "cd packages/move && sui move test",
    "move:publish:testnet": "cd packages/move && sui client publish --gas-budget 200000000"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
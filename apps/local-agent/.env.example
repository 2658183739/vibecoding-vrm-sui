LOCAL_AGENT_PORT=3777

# LLM 可选增强开关：
# - provider=none 或 LLM_API_KEY 为空 => 仅使用规则引擎
# - provider=openai/anthropic 且 LLM_API_KEY 不为空 => 启用 LLM 解析增强
# 注意：LLM 仅用于 text -> {intent,slots}，不会生成交易。
# openai | anthropic | none
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# OpenClaw CLI integration
# Install OpenClaw CLI first (see README section)
OPENCLAW_CLI_BIN=openclaw
OPENCLAW_BROWSER_PROFILE=openclaw

# Optional defaults injected into allowlist on first start
DEFAULT_DAPP_DOMAIN=2658183739.github.io
DEFAULT_DAPP_ORIGIN=http://localhost:5173


# DashScope / Bailian (Only for optional backend LLM enhancement)
# Please copy to packages/agent/.env.local and fill in values as needed.
# Note: Do not put in apps/web/.env (VITE_* will be bundled into frontend and exposed).

DASHSCOPE_API_KEY=REPLACE_WITH_YOUR_DASHSCOPE_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-max
